FROM python:3.11-slim

WORKDIR /app

# Install system dependencies including Oracle Instant Client prerequisites
RUN apt-get update && apt-get install -y \
    gcc \
    libaio1 \
    postgresql-client \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install Oracle Instant Client (Basic Lite) - version 21.x
# Download from Oracle: https://www.oracle.com/database/technologies/instant-client/linux-x86-64-downloads.html
# Files must be pre-downloaded and placed in the build context as oracle/ directory
COPY oracle/instantclient-basiclite-linux.x64-21.*.zip /tmp/
RUN mkdir -p /opt/oracle && \
    unzip /tmp/instantclient-basiclite-linux.x64-21.*.zip -d /opt/oracle && \
    rm /tmp/instantclient-basiclite-linux.x64-21.*.zip && \
    ln -s /opt/oracle/instantclient_21_* /opt/oracle/instantclient

# Set Oracle environment variables
ENV LD_LIBRARY_PATH=/opt/oracle/instantclient:$LD_LIBRARY_PATH
ENV ORACLE_HOME=/opt/oracle/instantclient

# Copy requirements and install Python dependencies (includes cx_Oracle)
COPY requirements-ai1.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy ETL scripts
COPY *.py ./
COPY .env.example .env

# Create log directory
RUN mkdir -p /var/log/healthbridge

# Create non-root user
RUN useradd -m -u 1000 etluser && \
    chown -R etluser:etluser /app /var/log/healthbridge
USER etluser

# Default command
CMD ["python", "run_etl.py"]
